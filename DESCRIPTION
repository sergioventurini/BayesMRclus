Package: BayesMRclus
Type: Package
Title: Bayesian Modeling for Two-Sample Summary-Data MR with Heterogeneity
Version: 0.0.8-0
Date: 2026-05-19
Authors@R: c(
  person("Sergio", "Venturini", role=c("aut", "cre"), email = "sergio.venturini@unicatt.it"),
